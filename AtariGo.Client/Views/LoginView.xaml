<Window x:Class="AtariGo.Client.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:properties="clr-namespace:AtariGo.Client.Properties"
        mc:Ignorable="d" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Title="Atari Go - Login">

    <Grid Background="#E5D8C5">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,25,0,0">
            <Button x:Name="BtnChangeLanguage" 
                    ToolTip="{x:Static properties:Resources.Login_Tip_ChangeLanguage}"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnChangeLanguage_Click"
                    Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static properties:Resources.Login_Btn_LanguageLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#333333"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="ATARI GO" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       FontFamily="Georgia" 
                       Foreground="#2C2A29" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>
            <Border Background="White" 
                    BorderBrush="#2C2A29" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    Width="420" 
                    Padding="35">

                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.Login_Lbl_Title}" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               FontFamily="Georgia"
                               Foreground="#2C2A29" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,25"/>

                    <TextBlock Text="{x:Static properties:Resources.Login_Lbl_Email}" 
                               FontWeight="SemiBold" 
                               Foreground="#2C2A29" 
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEmail" 
                             Height="38" 
                             Padding="10,8" 
                             VerticalContentAlignment="Center"
                             BorderBrush="#2C2A29" 
                             BorderThickness="1" 
                             Margin="0,0,0,18"/>

                    <TextBlock Text="{x:Static properties:Resources.Login_Lbl_Password}" 
                               FontWeight="SemiBold" 
                               Foreground="#2C2A29" 
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword" 
                                 Height="38" 
                                 Padding="10,8" 
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#2C2A29" 
                                 BorderThickness="1" 
                                 Margin="0,0,0,22" Cursor=""/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="{x:Static properties:Resources.Login_Btn_Submit}" 
                            Height="42" 
                            Background="#4A90E2" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            FontSize="14"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Margin="0,0,0,18"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8"><Hyperlink x:Name="LnkRegister" Foreground="#4A90E2"><InlineUIContainer>
                                <TextBlock Text="{x:Static properties:Resources.Login_Lnk_Register}"/>
                            </InlineUIContainer></Hyperlink></TextBlock>

                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,22"><Hyperlink x:Name="LnkForgotPassword" Foreground="#4A90E2"><InlineUIContainer>
                                <TextBlock Text="{x:Static properties:Resources.Login_Lnk_ForgotPassword}"/>
                            </InlineUIContainer></Hyperlink></TextBlock>

                    <Separator Background="#D9D9D9" Margin="0,0,0,20" Width="340"/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="{x:Static properties:Resources.Login_Btn_Guest}" 
                            Height="42" 
                            Background="#DCDCDC" 
                            Foreground="#2C2A29" 
                            FontWeight="Bold" 
                            FontSize="14"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid x:Name="LanguageOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="White" 
                    BorderBrush="#2C2A29" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    Width="340" 
                    Height="220" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static properties:Resources.Lang_Modal_Title}"
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#2C2A29" 
                               Margin="0,0,0,15" 
                               HorizontalAlignment="Center"/>

                    <ComboBox x:Name="CmbLanguages" Height="36" Margin="0,0,0,20" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Español (ES)" Tag="es"/>
                        <ComboBoxItem Content="English (EN)" Tag="en"/>
                        <ComboBoxItem Content="Deutsch (DE)" Tag="de"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnCancelLanguage" 
                                Style="{StaticResource RoundedButtonStyle}"
                                Content="{x:Static properties:Resources.Lang_Btn_Cancel}"
                                Width="100" 
                                Height="35" 
                                Margin="0,0,10,0" 
                                Background="#DCDCDC" 
                                Foreground="#2C2A29" 
                                FontWeight="Bold"
                                BorderBrush="#2C2A29"
                                BorderThickness="1"
                                Click="BtnCancelLanguage_Click"/>

                        <Button x:Name="BtnConfirmLanguage" 
                                Style="{StaticResource RoundedButtonStyle}"
                                Content="{x:Static properties:Resources.Lang_Btn_Accept}"
                                Width="100" 
                                Height="35" 
                                Background="#4A90E2" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                BorderBrush="#2C2A29"
                                BorderThickness="1"
                                Click="BtnConfirmLanguage_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Button x:Name="BtnExit" 
                Style="{StaticResource RoundedButtonStyle}"
                Background="#D9534F" 
                BorderBrush="#B52B27" 
                BorderThickness="1"
                Padding="15,6"
                Click="BtnExit_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,25,25,0">
            <TextBlock Text="{x:Static properties:Resources.Login_Btn_Exit}" 
                       Foreground="White" 
                       FontWeight="Bold"/>
        </Button>
    </Grid>
</Window>