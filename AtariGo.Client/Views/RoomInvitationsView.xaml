<UserControl x:Class="AtariGo.Client.Views.RoomInvitationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" Foreground="#2C2A29">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C2A29"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EAEAEA"/>
                    <Setter Property="Foreground" Value="#2C2A29"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RejectInvitationButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D9534F"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="24" FontFamily="Georgia"
                   Foreground="#2C2A29" FontWeight="Bold" Margin="0,0,0,20"
                   TextWrapping="Wrap"/>
        <Grid Visibility="{Binding IsOutgoing,
                Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl x:Name="OnlineFriendsList" ItemsSource="{Binding OnlineFriends}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FDFBF7" BorderBrush="#D6C7B5"
                                BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="#2E7D32"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding UserName}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#2C2A29"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Margin="12,0,0,0"
                                    Content="{Binding DataContext.SendLabel,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Command="{Binding DataContext.SendCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsEnabled="{Binding DataContext.CanSend,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding EmptyFriendsLabel}" TextWrapping="Wrap"
                       Foreground="#666666" Margin="0,10,0,18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=OnlineFriendsList}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <StackPanel Margin="0,8,0,12" Visibility="{Binding IsOutgoing,
                    Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding EmailFriendLabel}" Margin="0,0,0,8"
                       FontSize="14" FontWeight="SemiBold" Foreground="#2C2A29"
                       TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding EmailFriends}" DisplayMemberPath="UserName"
                      SelectedItem="{Binding SelectedEmailFriend}" Height="38"
                      Background="#FDFBF7" BorderBrush="#2C2A29" BorderThickness="1.5"
                      FontSize="14" FontWeight="SemiBold" Padding="8"
                      VerticalContentAlignment="Center"
                      IsEnabled="{Binding CanSend}"/>
            <Button Content="{Binding SendEmailLabel}" Command="{Binding SendEmailCommand}"
                    IsEnabled="{Binding CanSendEmail}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsIncoming,
                    Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListBox x:Name="IncomingInvitationsList" ItemsSource="{Binding Invitations}"
                     SelectedItem="{Binding SelectedInvitation}"
                     MaxHeight="240" IsEnabled="{Binding CanInteract}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="#FDFBF7"/>
                        <Setter Property="BorderBrush" Value="#D6C7B5"/>
                        <Setter Property="Foreground" Value="#2C2A29"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E7F0FA"/>
                                <Setter Property="BorderBrush" Value="#4A90E2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold"
                                       FontSize="14" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding RoomCode}" FontFamily="Consolas"
                                           Foreground="#4A90E2" FontWeight="Bold" FontSize="13"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding StateLabel}" Foreground="#666666"
                                           FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding EmptyInvitationsLabel}" Foreground="#666666"
                       TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=IncomingInvitationsList}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Button Content="{Binding RejectLabel}" Command="{Binding RejectCommand}"
                        Style="{StaticResource RejectInvitationButtonStyle}"
                        IsEnabled="{Binding CanRespond}" Margin="0,0,5,0"/>
                <Button Content="{Binding AcceptLabel}" Command="{Binding AcceptCommand}"
                        IsEnabled="{Binding CanRespond}" Margin="5,0,0,0"/>
            </UniformGrid>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                   Foreground="#555555" Margin="0,12,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Content="{Binding CloseLabel}" Command="{Binding CloseCommand}"
                IsEnabled="{Binding CanInteract}" Background="#EAEAEA" Foreground="#333333" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
