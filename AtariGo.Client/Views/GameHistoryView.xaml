<UserControl x:Class="AtariGo.Client.Views.GameHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E5D8C5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#2C2A29" Padding="25,15">
            <TextBlock Text="{Binding TitleLabel}" FontSize="20" FontWeight="Bold"
                       FontFamily="Georgia" Foreground="White"/>
        </Border>
        <Border Grid.Row="1" Margin="28" Padding="24" Background="White"
                BorderBrush="#2C2A29" BorderThickness="1.5" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding TitleLabel}" FontSize="28" FontWeight="Bold"
                           FontFamily="Georgia" Foreground="#2C2A29" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{Binding DescriptionLabel}" Foreground="#666666"
                           TextWrapping="Wrap" Margin="0,8,0,12"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2C2A29"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Background="#F1EBE1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DateLabel}" Margin="10" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{Binding OpponentLabel}" Margin="10"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{Binding ResultLabel}" Margin="10"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="3" Text="{Binding StoneColorLabel}" Margin="10"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="4" Text="{Binding OpponentStoneColorLabel}"
                                   Margin="10" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD5C9" BorderThickness="0,0,0,1">
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.35*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.25*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateLabel}" Margin="10"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OpponentName}"
                                                       Margin="10" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ResultLabel}"
                                                       Margin="10" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StoneColorLabel}"
                                                       Margin="10" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding OpponentStoneColorLabel}"
                                                       Margin="10" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding BackLabel}" Command="{Binding BackCommand}"
                            Style="{StaticResource RoundedButtonStyle}"
                            MinHeight="44" Padding="12,8" Background="#D9534F"
                            Foreground="White" FontWeight="Bold"/>
                    <Button Grid.Column="2" Content="{Binding RefreshLabel}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource RoundedButtonStyle}"
                            MinHeight="44" Padding="12,8"
                            Background="#4A90E2" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
