<UserControl x:Class="AtariGo.Client.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="#E5D8C5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ATARI GO"
                       FontSize="36"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="#2C2A29"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding PlayerName, StringFormat='Welcome, {0}!'}"
                       FontSize="16"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <Border Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Width="400"
                    Padding="35">
                <StackPanel>
                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="Play Multiplayer"
                            Command="{Binding PlayMultiplayerCommand}"
                            Height="44"
                            Background="#4A90E2"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Margin="0,0,0,15"/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="Create Private Room"
                            Command="{Binding CreatePrivateRoomCommand}"
                            Height="44"
                            Background="#5CB85C"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Margin="0,0,0,15"/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="Join with Code"
                            Command="{Binding JoinWithCodeCommand}"
                            Height="44"
                            Background="#F0AD4E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Margin="0,0,0,20"/>

                    <Separator Background="#DDDDDD" Margin="0,0,0,20"/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="Exit"
                            Command="{Binding ExitCommand}"
                            Height="40"
                            Background="#D9534F"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="#B52B27"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
