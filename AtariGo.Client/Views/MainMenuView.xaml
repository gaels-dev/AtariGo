<UserControl x:Class="AtariGo.Client.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#E5D8C5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C2A29" Padding="25,15">
            <Grid>
                <TextBlock Text="ATARI GO"
                           FontSize="20"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White">
                    <Run Text="{x:Static properties:Resources.MainMenu_Lbl_Welcome}"/>
                    <Run Text="{Binding PlayerName, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- SECTION 1 -->
            <StackPanel Grid.Column="0" Margin="0,5,10,0" VerticalAlignment="Top">
                <Border Background="White"
                        BorderBrush="#2C2A29"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Grid Width="45" Height="45" Margin="0,0,12,0">
                                <Ellipse Fill="#E0D7C6"
                                         Stroke="#2C2A29"
                                         StrokeThickness="1.5"/>
                                <TextBlock Text="👤"
                                           FontSize="22"
                                           Foreground="#4A90E2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Static
                                        properties:Resources.MainMenu_Lbl_YourProfile}"
                                    FontWeight="Bold"
                                    FontSize="15"
                                    Foreground="#2C2A29"/>
                                <TextBlock FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#2E7D32">
                                    <Run Text="{x:Static
                                        properties:Resources.MainMenu_Lbl_Victories}"/>
                                    <Run Text="{Binding PlayerWins, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource RoundedButtonStyle}"
                                Content="{x:Static
                                    properties:Resources.MainMenu_Btn_Customize}"
                                Command="{Binding CustomizeProfileCommand}"
                                Height="35"
                                Background="#EAEAEA"
                                Foreground="#333333"
                                FontWeight="Bold"
                                FontSize="13"
                                BorderBrush="#2C2A29"
                                BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#2C2A29"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock
                                Text="{x:Static properties:Resources.MainMenu_Lbl_TopGlobal}"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="#2C2A29"
                                HorizontalAlignment="Left"/>
                            <TextBlock
                                Text="{x:Static properties:Resources.MainMenu_Lbl_WinsHeader}"
                                FontSize="11"
                                Foreground="#666666"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"/>
                        </Grid>
                        <StackPanel>
                            <Grid Margin="0,4">
                                <TextBlock Text="1. MaestroGo" FontSize="13"/>
                                <TextBlock Text="110"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="2. NinjaNegro" FontSize="13"/>
                                <TextBlock Text="85"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="3. Jugador123"
                                           FontSize="13"
                                           FontWeight="Bold"/>
                                <TextBlock Text="54"
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Rectangle Grid.Column="1"
                       Width="1.5"
                       Fill="#C4B59D"
                       Margin="10,0"/>

            <!-- SECTION 2 -->
            <Border Grid.Column="2"
                    Background="#E5D8C5"
                    Padding="15"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Width="320">
                    <TextBlock
                        Text="{x:Static properties:Resources.MainMenu_Lbl_WhatToDo}"
                        FontSize="25"
                        FontWeight="Bold"
                        FontFamily="Georgia"
                        Foreground="#2C2A29"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25"/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="{x:Static
                                properties:Resources.MainMenu_Btn_PlayMultiplayer}"
                            Command="{Binding PlayMultiplayerCommand}"
                            Height="45"
                            Background="#4A90E2"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource RoundedButtonStyle}"
                                Content="{x:Static
                                    properties:Resources.MainMenu_Btn_CreatePrivateRoom}"
                                Command="{Binding CreatePrivateRoomCommand}"
                                Height="45"
                                Background="#4A90E2"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                BorderBrush="#2C2A29"
                                BorderThickness="1"
                                Margin="0,0,6,0"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource RoundedButtonStyle}"
                                Content="{x:Static
                                    properties:Resources.MainMenu_Btn_JoinWithCode}"
                                Command="{Binding JoinWithCodeCommand}"
                                Height="45"
                                Background="#8C939A"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                BorderBrush="#2C2A29"
                                BorderThickness="1"
                                Margin="6,0,0,0"/>
                    </Grid>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="{x:Static properties:Resources.MainMenu_Btn_Options}"
                            Command="{Binding OptionsCommand}"
                            Height="42"
                            Background="#DCDCDC"
                            Foreground="#2C2A29"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="#2C2A29"
                            Margin="0,0,0,12"/>

                    <Button Style="{StaticResource RoundedButtonStyle}"
                            Content="{x:Static properties:Resources.MainMenu_Btn_SignOut}"
                            Command="{Binding ExitCommand}"
                            Height="42"
                            Background="#D9534F"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderBrush="#B52B27"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>

            <Rectangle Grid.Column="3"
                       Width="1.5"
                       Fill="#C4B59D"
                       Margin="10,0"/>

            <!-- SECTION 3 -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="15"
                    Margin="10,5,0,0"
                    VerticalAlignment="Top"
                    Height="480">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{x:Static
                                   properties:Resources.MainMenu_Lbl_FriendsList}"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="#2C2A29"
                               Margin="0,0,0,12"/>

                    <Button Grid.Row="1"
                            Style="{StaticResource RoundedButtonStyle}"
                            Content="{x:Static
                                properties:Resources.MainMenu_Btn_AddFriend}"
                            Command="{Binding AddFriendCommand}"
                            Height="36"
                            Background="#EAEAEA"
                            Foreground="#333333"
                            FontWeight="Bold"
                            FontSize="12"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Margin="0,0,0,12"/>

                    <Border Grid.Row="2"
                            BorderBrush="#2C2A29"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,12">
                        <TextBox BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock Foreground="#999999"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                    <TextBlock.Text>
                        <x:Static
                            Member="properties:Resources.MainMenu_Txt_SearchFriendPlaceholder"/>
                    </TextBlock.Text>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value=""
                                                                        Binding="{Binding
                                                                            Text,
                                                                            RelativeSource={
                                                                            RelativeSource
                                                                            TemplatedParent}}">
                                                                        <Setter
                                                                            Property="Visibility"
                                                                            Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="#2C2A29"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10"
                                                 Fill="#2E7D32"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Alex99"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RoundedButtonStyle}"
                                                Content="{x:Static
                                                    properties:Resources.MainMenu_Btn_Invite}"
                                                Command="{Binding InviteFriendCommand}"
                                                Width="52" Height="26"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Margin="0,0,6,0"
                                                Background="#4A90E2"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                        <Button Style="{StaticResource RoundedButtonStyle}"
                                                Content="X"
                                                Command="{Binding RemoveFriendCommand}"
                                                Width="26" Height="26"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Background="#D9534F"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#2C2A29"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10"
                                                 Fill="#2E7D32"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="SaraGo"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RoundedButtonStyle}"
                                                Content="{x:Static
                                                    properties:Resources.MainMenu_Btn_Invite}"
                                                Command="{Binding InviteFriendCommand}"
                                                Width="52" Height="26"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Margin="0,0,6,0"
                                                Background="#4A90E2"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                        <Button Style="{StaticResource RoundedButtonStyle}"
                                                Content="X"
                                                Command="{Binding RemoveFriendCommand}"
                                                Width="26" Height="26"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Background="#D9534F"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#2C2A29"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10"
                                                 Stroke="#888888"
                                                 StrokeThickness="1.5"
                                                 Fill="Transparent"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="JorgePro"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RoundedButtonStyle}"
                                                Content="{x:Static
                                                    properties:Resources.MainMenu_Btn_Email}"
                                                Command="{Binding EmailFriendCommand}"
                                                Width="58" Height="26"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Margin="0,0,6,0"
                                                Background="#EAEAEA"
                                                Foreground="#333333"
                                                BorderThickness="0"/>
                                        <Button Style="{StaticResource RoundedButtonStyle}"
                                                Content="X"
                                                Command="{Binding RemoveFriendCommand}"
                                                Width="26" Height="26"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Background="#D9534F"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
