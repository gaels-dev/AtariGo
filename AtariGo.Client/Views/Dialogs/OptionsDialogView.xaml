<UserControl x:Class="AtariGo.Client.Views.Dialogs.OptionsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="BlueCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="chkBorder"
                                Width="24"
                                Height="24"
                                CornerRadius="5"
                                Background="White"
                                BorderBrush="#2C2A29"
                                BorderThickness="1.5">
                            <TextBlock x:Name="chkMark"
                                       Text="✓"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder"
                                        Property="Background"
                                        Value="#357ABD"/>
                                <Setter TargetName="chkBorder"
                                        Property="BorderBrush"
                                        Value="#2C2A29"/>
                                <Setter TargetName="chkMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#2C2A29"
            BorderThickness="1.5"
            CornerRadius="12"
            Width="340"
            Padding="22">
        <StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="⚙"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2C2A29"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static properties:Resources.Options_Lbl_Title}"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#2C2A29"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4,0,14"/>

            <Grid Margin="0,0,0,14">
                <TextBlock
                    Text="{x:Static properties:Resources.Options_Lbl_BackgroundMusic}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#2C2A29"
                    VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Style="{StaticResource BlueCheckBoxStyle}"
                              IsChecked="{Binding IsMusicEnabled}"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="♫"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#8E44AD"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
                <TextBlock
                    Text="{x:Static properties:Resources.Options_Lbl_SoundEffects}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#2C2A29"
                    VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Style="{StaticResource BlueCheckBoxStyle}"
                              IsChecked="{Binding IsSoundEffectsEnabled}"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="🔊"
                               FontSize="16"
                               Foreground="#E67E22"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐"
                               FontSize="16"
                               Foreground="#357ABD"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock
                        Text="{x:Static properties:Resources.Options_Lbl_Language}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Right"
                          Width="140"
                          Height="32"
                          Background="#FDFBF7"
                          BorderBrush="#2C2A29"
                          BorderThickness="1.5"
                          FontSize="13"
                          FontWeight="SemiBold"
                          VerticalContentAlignment="Center"/>
            </Grid>

            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,6,0,12"/>

            <TextBlock Text="{x:Static properties:Resources.Options_Lbl_AppVersion}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="© 2026"
                       FontSize="11"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,14"/>

            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{x:Static properties:Resources.Options_Btn_SaveAndClose}"
                    Command="{Binding SaveAndCloseCommand}"
                    Height="42"
                    Background="#3B82F6"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
        </StackPanel>
    </Border>
</UserControl>
