<UserControl x:Class="AtariGo.Client.Views.Dialogs.LoginVerificationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="430" MaxHeight="610">
    <Border Background="White" BorderBrush="#2C2A29" BorderThickness="1.5"
            CornerRadius="12" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                           FontFamily="Georgia" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ExpiresAt}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding CodeLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEdit}" MaxLength="8" Height="36" Padding="8"
                         Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding CanEdit}" MinHeight="40" Margin="0,0,0,8"
                        Background="#4A90E2" Foreground="White"
                        Style="{DynamicResource RoundedButtonStyle}"/>
                <Button Content="{Binding ResendLabel}" Command="{Binding ResendCommand}"
                        IsEnabled="{Binding CanEdit}" MinHeight="40" Margin="0,0,0,8"
                        Background="#4A90E2" Foreground="White"
                        Style="{DynamicResource RoundedButtonStyle}"/>
                <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                        MinHeight="40" Style="{DynamicResource RoundedButtonStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
