<UserControl x:Class="AtariGo.Client.Views.Dialogs.ChangePasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">
    <Border Background="White" BorderBrush="#2C2A29" BorderThickness="1.5"
            CornerRadius="12" Padding="28">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                           FontFamily="Georgia" Foreground="#2C2A29" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="{Binding CurrentPasswordLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="CurrentPasswordBox" Height="38" Padding="10,8"
                                 Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding NewPasswordLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="NewPasswordBox" Height="38" Padding="10,8"
                                 Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ConfirmationLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ConfirmationPasswordBox" Height="38" Padding="10,8"
                                 Margin="0,0,0,12"/>
                </StackPanel>
                <TextBlock Text="{Binding PolicyLabel}" TextWrapping="Wrap" Foreground="#666666"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#2C2A29"
                           FontWeight="SemiBold" Margin="0,0,0,12"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Content="{Binding SaveLabel}" Click="OnSaveButtonClick"
                        IsEnabled="{Binding CanEdit}" MinHeight="42" Padding="10,8"
                        Background="#4A90E2" Foreground="White" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}" Margin="0,0,0,10"/>
                <Button Content="{Binding DismissLabel}" Command="{Binding DismissCommand}"
                        IsEnabled="{Binding CanDismiss}" MinHeight="42" Padding="10,8"
                        Background="#DCDCDC" Foreground="#2C2A29" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
