<UserControl x:Class="AtariGo.Client.Views.Dialogs.ForgotPasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             Width="400">

    <Border Background="White" BorderBrush="#2C2A29" BorderThickness="1.5"
            CornerRadius="12" Padding="30">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="Bold" FontFamily="Georgia"
                       Foreground="#2C2A29" HorizontalAlignment="Center"
                       Margin="0,0,0,20">
                <TextBlock.Text>
                    <x:Static Member="properties:Resources.ForgotPassword_Lbl_Title"/>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock FontWeight="SemiBold" Foreground="#2C2A29" Margin="0,0,0,6">
                <TextBlock.Text>
                    <x:Static Member="properties:Resources.ForgotPassword_Lbl_EmailOrUsername"/>
                </TextBlock.Text>
            </TextBlock>
            <TextBox Text="{Binding EmailOrUsername, UpdateSourceTrigger=PropertyChanged}"
                     Height="38" Padding="10,8" VerticalContentAlignment="Center"
                     BorderBrush="#2C2A29" BorderThickness="1" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Style="{StaticResource RoundedButtonStyle}"
                    Command="{Binding AcceptCommand}"
                    Height="42" Background="#4A90E2" Foreground="White"
                    FontWeight="Bold" FontSize="14"
                    BorderBrush="#2C2A29" BorderThickness="1" Margin="0,0,0,10">
                <Button.Content>
                    <x:Static Member="properties:Resources.ForgotPassword_Btn_Accept"/>
                </Button.Content>
            </Button>

            <Button Style="{StaticResource RoundedButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Height="42" Background="#DCDCDC" Foreground="#2C2A29"
                    FontWeight="Bold" FontSize="14"
                    BorderBrush="#2C2A29" BorderThickness="1">
                <Button.Content>
                    <x:Static Member="properties:Resources.ForgotPassword_Btn_Cancel"/>
                </Button.Content>
            </Button>
        </StackPanel>
    </Border>
</UserControl>