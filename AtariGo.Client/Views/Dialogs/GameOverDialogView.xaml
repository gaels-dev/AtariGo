<UserControl x:Class="AtariGo.Client.Views.Dialogs.GameOverDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Background="White"
            BorderBrush="#2C2A29"
            BorderThickness="1.5"
            CornerRadius="10"
            Width="400"
            Padding="28">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#2C2A29"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBlock Text="{Binding Message}"
                       FontSize="15"
                       Foreground="#444444"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       LineHeight="22"
                       Margin="0,0,0,26"/>

            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding ActionButtonText}"
                    Command="{Binding AcceptCommand}"
                    Width="170"
                    Height="40"
                    Background="#2C2A29"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderBrush="#1A1A1A"
                    BorderThickness="1"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
