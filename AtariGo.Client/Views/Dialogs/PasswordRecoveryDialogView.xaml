<UserControl x:Class="AtariGo.Client.Views.Dialogs.PasswordRecoveryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460" MaxHeight="610">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="StageVisibility"/>
    </UserControl.Resources>
    <Border Background="White" BorderBrush="#2C2A29" BorderThickness="1.5"
            CornerRadius="12" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                           FontFamily="Georgia" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding IdentifierLabel}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditIdentifier}" MaxLength="254"
                         Height="36" Padding="8" Margin="0,0,0,12"/>
                <StackPanel Visibility="{Binding IsResetStage, Converter={StaticResource StageVisibility}}"
                            IsEnabled="{Binding CanReset}">
                    <TextBlock Text="{Binding CodeLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="8" Height="36" Padding="8" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding NewPasswordLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="NewPasswordBox" Height="36" Padding="8"
                                 MaxLength="255" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ConfirmationLabel}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ConfirmationPasswordBox" Height="36" Padding="8"
                                 MaxLength="255" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding PolicyLabel}" TextWrapping="Wrap"
                               Foreground="#666666" Margin="0,0,0,12"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#2C2A29"
                           FontWeight="SemiBold" Margin="0,0,0,12"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Content="{Binding ResetLabel}" Click="OnResetButtonClick"
                        Visibility="{Binding IsResetStage, Converter={StaticResource StageVisibility}}"
                        IsEnabled="{Binding CanReset}" MinHeight="40" Padding="10,8"
                        Background="#4A90E2" Foreground="White" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="{Binding RequestLabel}" Command="{Binding RequestCommand}"
                        IsEnabled="{Binding CanEdit}" MinHeight="40" Padding="10,8"
                        Background="#4A90E2" Foreground="White" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                        MinHeight="40" Padding="10,8" Background="#DCDCDC"
                        Foreground="#2C2A29" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
