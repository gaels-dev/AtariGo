<UserControl x:Class="AtariGo.Client.Views.Dialogs.RegistrationResultDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="430">
    <Border Background="White"
            BorderBrush="#2C2A29"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="30">
        <StackPanel>
            <TextBlock Text="{Binding Message}"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="#2C2A29"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,5,0,24"/>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding CloseButtonText}"
                    Command="{Binding CloseCommand}"
                    Height="58"
                    Background="#DCDCDC"
                    Foreground="#2C2A29"
                    FontWeight="Bold"
                    FontSize="18"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
        </StackPanel>
    </Border>
</UserControl>
