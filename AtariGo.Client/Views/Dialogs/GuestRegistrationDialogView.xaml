<UserControl x:Class="AtariGo.Client.Views.Dialogs.GuestRegistrationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="475">
    <Border Background="White"
            BorderBrush="#2C2A29"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="30">
        <StackPanel>
            <TextBlock Text="{Binding TitleText}"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="#2C2A29"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            <TextBlock Text="{Binding NameLabel}"
                       FontWeight="SemiBold"
                       Foreground="#2C2A29"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding GuestName,
                                 UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding NamePlaceholder}"
                     Height="42"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     BorderBrush="#2C2A29"
                     BorderThickness="1.5"
                     Margin="0,0,0,8"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#B52B27"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding EnterLabel}"
                    Command="{Binding EnterCommand}"
                    Height="52"
                    Margin="0,12,0,10"
                    Background="#4A90E2"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding BackLabel}"
                    Command="{Binding BackCommand}"
                    Height="52"
                    Background="#DCDCDC"
                    Foreground="#2C2A29"
                    FontWeight="Bold"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
        </StackPanel>
    </Border>
</UserControl>
