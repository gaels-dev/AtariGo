<UserControl x:Class="AtariGo.Client.Views.Dialogs.ReportPlayerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d">

    <Border Background="White"
            BorderBrush="#2C2A29"
            BorderThickness="1.5"
            CornerRadius="8"
            Width="420"
            Padding="25">
        <StackPanel>
            <TextBlock Text="{x:Static properties:Resources.ReportPlayer_Lbl_Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#2C2A29"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15">
                <Run Text="{x:Static properties:Resources.ReportPlayer_Lbl_PlayerFormat}"/><Run Text="{Binding TargetPlayerName, Mode=OneWay}"/>
            </TextBlock>

            <TextBlock Text="{x:Static properties:Resources.ReportPlayer_Lbl_Reason}"
                       FontWeight="SemiBold"
                       Foreground="#2C2A29"
                       Margin="0,0,0,5"/>

            <ComboBox ItemsSource="{Binding Reasons}"
                      SelectedItem="{Binding SelectedReason}"
                      Height="36"
                      VerticalContentAlignment="Center"
                      Margin="0,0,0,15"/>

            <TextBlock Text="{x:Static properties:Resources.ReportPlayer_Lbl_Details}"
                       FontWeight="SemiBold"
                       Foreground="#2C2A29"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                     Height="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8"
                     BorderBrush="#2C2A29"
                     BorderThickness="1"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource RoundedButtonStyle}"
                        Content="{x:Static properties:Resources.ReportPlayer_Btn_Cancel}"
                        Command="{Binding CancelCommand}"
                        Width="110"
                        Height="36"
                        Background="#DCDCDC"
                        Foreground="#2C2A29"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        BorderThickness="1"
                        Margin="0,0,15,0"/>

                <Button Style="{StaticResource RoundedButtonStyle}"
                        Content="{x:Static properties:Resources.ReportPlayer_Btn_Submit}"
                        Command="{Binding SubmitCommand}"
                        Width="130"
                        Height="36"
                        Background="#D9534F"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#B52B27"
                        BorderThickness="1"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
