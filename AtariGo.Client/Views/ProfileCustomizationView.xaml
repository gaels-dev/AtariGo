<UserControl x:Class="AtariGo.Client.Views.ProfileCustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             xmlns:converters="clr-namespace:AtariGo.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">

    <UserControl.Resources>
        <converters:AvatarIdToImageConverter x:Key="AvatarImageConverter"/>
        <BooleanToVisibilityConverter x:Key="VisibilityConverter"/>
        <Style x:Key="AvatarSelectionBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvatarPickerOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="480"
                    Padding="30"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Title}"
                        FontSize="28"
                        FontWeight="Bold"
                        FontFamily="Georgia"
                        Foreground="#2C2A29"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_SelectAvatar}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding IsLoaded}"
                                Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding FeaturedAvatars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource RoundedButtonStyle}"
                                            Command="{Binding DataContext.SelectAvatarCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="70"
                                            Height="70"
                                            Margin="3"
                                            Background="White"
                                            BorderBrush="#2C2A29"
                                            BorderThickness="1.5">
                                        <Border Style="{StaticResource AvatarSelectionBorderStyle}">
                                            <Image Source="{Binding AvatarId,
                                                Converter={StaticResource AvatarImageConverter}}"
                                                   Width="54"
                                                   Height="54"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding ViewMoreLabel}"
                                Command="{Binding OpenAvatarPickerCommand}"
                                Style="{DynamicResource RoundedButtonStyle}"
                                Width="70"
                                Height="70"
                                Margin="3"
                                Background="#E5D8C5"
                                Foreground="#2C2A29"
                                FontWeight="Bold"
                                TextBlock.TextAlignment="Center"
                                BorderBrush="#2C2A29"
                                BorderThickness="1.5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15">
                        <Image Source="{Binding SelectedAvatarId,
                            Converter={StaticResource AvatarImageConverter}}"
                               Width="28"
                               Height="28"
                               Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedAvatarLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="#2C2A29"/>
                        <TextBlock Text="{Binding SelectedAvatarId}"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="#2C2A29"/>
                    </StackPanel>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Username}"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,5"/>

                    <TextBox
                        Text="{Binding PlayerName,
                            UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="15"
                        IsEnabled="{Binding IsLoaded}"
                        Height="36"
                        Padding="8"
                        FontSize="14"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Email}"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,5"/>

                    <TextBox Text="{Binding Email, Mode=OneWay}"
                             Height="36"
                             Padding="8"
                             FontSize="14"
                             IsReadOnly="True"
                             Background="#EEEEEE"
                             Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="{Binding WinsLabel}"
                                   FontWeight="Bold"
                                   Foreground="#2C2A29"/>
                        <TextBlock Text="{Binding Wins}"
                                   Margin="8,0,0,0"
                                   Foreground="#2C2A29"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#2E7D32"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_Update}"
                        Command="{Binding UpdateProfileCommand}"
                        Style="{DynamicResource RoundedButtonStyle}"
                        IsEnabled="{Binding IsLoaded}"
                        Height="42"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        Margin="0,0,0,10"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_ChangePassword}"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Height="42"
                        Background="#E5D8C5"
                        Foreground="#2C2A29"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        Margin="0,0,0,10"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_Close}"
                        Command="{Binding BackCommand}"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Height="42"
                        Background="#D9534F"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#B52B27"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2"
              Panel.ZIndex="10"
              Visibility="{Binding IsAvatarPickerOpen,
                  Converter={StaticResource VisibilityConverter}}">
            <Border Background="#B3000000"/>
            <Border Width="690"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding AllAvatarsLabel}"
                               FontFamily="Georgia"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#2C2A29"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1"
                                  Height="420"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AvailableAvatars}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Width="600"
                                               ItemWidth="120"
                                               ItemHeight="164"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="116"
                                                HorizontalAlignment="Center">
                                        <Button Style="{DynamicResource RoundedButtonStyle}"
                                                Command="{Binding DataContext.SelectAvatarCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsUnlocked}"
                                                ToolTip="{Binding UnlockRequirement}"
                                                Width="94"
                                                Height="94"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="#2C2A29"
                                                BorderThickness="1.5">
                                            <Border Style="{StaticResource AvatarSelectionBorderStyle}">
                                                <Image Source="{Binding AvatarId,
                                                    Converter={StaticResource AvatarImageConverter}}"
                                                       Width="80"
                                                       Height="80"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </Button>
                                        <TextBlock Text="{Binding AvatarId}"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="#2C2A29"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding UnlockRequirement}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="#555555"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="{Binding CloseAvatarPickerLabel}"
                            Command="{Binding CloseAvatarPickerCommand}"
                            Style="{DynamicResource RoundedButtonStyle}"
                            Width="180"
                            Height="40"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Background="#E5D8C5"
                            Foreground="#2C2A29"
                            FontWeight="Bold"
                            BorderBrush="#2C2A29"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
