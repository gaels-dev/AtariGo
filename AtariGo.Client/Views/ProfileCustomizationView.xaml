<UserControl x:Class="AtariGo.Client.Views.ProfileCustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Border Width="480"
                    Padding="30"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Title}"
                        FontSize="28"
                        FontWeight="Bold"
                        FontFamily="Georgia"
                        Foreground="#2C2A29"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_SelectAvatar}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding AvailableAvatars}"
                                  Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding}"
                                    Command="{Binding
                                        DataContext.SelectAvatarCommand,
                                        RelativeSource={
                                            RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="70"
                                    Height="70"
                                    Margin="8"
                                    FontSize="30"
                                    Background="#F5F1EA"
                                    BorderBrush="#2C2A29"
                                    BorderThickness="1.5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Username}"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,5"/>

                    <TextBox
                        Text="{Binding PlayerName,
                            UpdateSourceTrigger=PropertyChanged}"
                        Height="36"
                        Padding="8"
                        FontSize="14"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Email}"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,5"/>

                    <TextBox Text="{Binding Email}"
                             Height="36"
                             Padding="8"
                             FontSize="14"
                             IsReadOnly="True"
                             Background="#EEEEEE"
                             Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#2E7D32"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_Update}"
                        Command="{Binding UpdateProfileCommand}"
                        Height="42"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        Margin="0,0,0,10"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_ChangePassword}"
                        Command="{Binding ChangePasswordCommand}"
                        Height="42"
                        Background="#E5D8C5"
                        Foreground="#2C2A29"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        Margin="0,0,0,10"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_Close}"
                        Command="{Binding BackCommand}"
                        Height="42"
                        Background="#D9534F"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#B52B27"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>