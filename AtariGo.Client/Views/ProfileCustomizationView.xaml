<UserControl x:Class="AtariGo.Client.Views.ProfileCustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             xmlns:converters="clr-namespace:AtariGo.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">

    <UserControl.Resources>
        <converters:AvatarIdToImageConverter x:Key="AvatarImageConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Border Width="480"
                    Padding="30"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Title}"
                        FontSize="28"
                        FontWeight="Bold"
                        FontFamily="Georgia"
                        Foreground="#2C2A29"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_SelectAvatar}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,10"/>

                    <ListBox ItemsSource="{Binding AvailableAvatars}"
                             SelectedItem="{Binding SelectedAvatarId, Mode=TwoWay}"
                             IsEnabled="{Binding IsLoaded}"
                             BorderThickness="0"
                             Margin="0,0,0,20">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="3"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="BorderBrush" Value="#2C2A29"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#1976D2"/>
                                        <Setter Property="BorderThickness" Value="3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Converter={StaticResource AvatarImageConverter}}"
                                       Width="62"
                                       Height="62"
                                       Stretch="UniformToFill"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Username}"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,5"/>

                    <TextBox
                        Text="{Binding PlayerName,
                            UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="15"
                        IsEnabled="{Binding IsLoaded}"
                        Height="36"
                        Padding="8"
                        FontSize="14"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.ProfileCustomization_Lbl_Email}"
                        FontWeight="Bold"
                        Foreground="#2C2A29"
                        Margin="0,0,0,5"/>

                    <TextBox Text="{Binding Email, Mode=OneWay}"
                             Height="36"
                             Padding="8"
                             FontSize="14"
                             IsReadOnly="True"
                             Background="#EEEEEE"
                             Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="{Binding WinsLabel}"
                                   FontWeight="Bold"
                                   Foreground="#2C2A29"/>
                        <TextBlock Text="{Binding Wins}"
                                   Margin="8,0,0,0"
                                   Foreground="#2C2A29"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#2E7D32"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_Update}"
                        Command="{Binding UpdateProfileCommand}"
                        IsEnabled="{Binding IsLoaded}"
                        Height="42"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        Margin="0,0,0,10"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_ChangePassword}"
                        Command="{Binding ChangePasswordCommand}"
                        Height="42"
                        Background="#E5D8C5"
                        Foreground="#2C2A29"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        Margin="0,0,0,10"/>

                    <Button
                        Content="{x:Static properties:Resources.ProfileCustomization_Btn_Close}"
                        Command="{Binding BackCommand}"
                        Height="42"
                        Background="#D9534F"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#B52B27"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
