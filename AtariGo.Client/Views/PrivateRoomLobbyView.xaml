<UserControl x:Class="AtariGo.Client.Views.PrivateRoomLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Border Grid.Row="1"
                Width="520"
                Padding="30"
                Background="White"
                BorderBrush="#2C2A29"
                BorderThickness="1.5"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock
                    Text="{x:Static properties:Resources.PrivateRoom_Lbl_Title}"
                    FontSize="28"
                    FontWeight="Bold"
                    FontFamily="Georgia"
                    Foreground="#2C2A29"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

                <TextBlock
                    Text="{x:Static properties:Resources.PrivateRoom_Lbl_InvitationCode}"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding RoomCode}"
                           FontSize="30"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="#4A90E2"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Text="{x:Static properties:Resources.PrivateRoom_Lbl_YouHost}"
                            FontSize="17"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsHost,
                                Converter={
                                    StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock
                            Text="{x:Static properties:Resources.PrivateRoom_Lbl_Host}"
                            FontSize="17"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsGuest,
                                Converter={
                                    StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="VS"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Text="{Binding OpponentName}"
                            FontSize="17"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsHost,
                                Converter={
                                    StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock
                            Text="{x:Static properties:Resources.PrivateRoom_Lbl_YouGuest}"
                            FontSize="17"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsGuest,
                                Converter={
                                    StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <Border Background="#F5F1EA"
                        BorderBrush="#2C2A29"
                        BorderThickness="1"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Static properties:Resources.PrivateRoom_Lbl_ActiveRules}"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TargetCaptures}"
                                       FontWeight="Bold"/>

                            <TextBlock
                                Text="{x:Static properties:Resources.PrivateRoom_Lbl_Captures}"
                                Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button
                    Content="{x:Static properties:Resources.PrivateRoom_Btn_InviteFriends}"
                    Command="{Binding InviteFriendsCommand}"
                    Height="42"
                    Background="#4A90E2"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsHost,
                        Converter={
                            StaticResource BooleanToVisibilityConverter}}"/>

                <Button
                    Content="{x:Static properties:Resources.PrivateRoom_Btn_SimulateOpponent}"
                    Command="{Binding SimulateOpponentCommand}"
                    Height="42"
                    Background="#E5D8C5"
                    Foreground="#2C2A29"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>

                <Button
                    Content="{x:Static properties:Resources.PrivateRoom_Btn_Disband}"
                    Command="{Binding LeaveRoomCommand}"
                    Height="42"
                    Background="#D9534F"
                    Foreground="White"
                    FontWeight="Bold"
                    Visibility="{Binding IsHost,
                        Converter={
                            StaticResource BooleanToVisibilityConverter}}"/>

                <Button
                    Content="{x:Static properties:Resources.PrivateRoom_Btn_Leave}"
                    Command="{Binding LeaveRoomCommand}"
                    Height="42"
                    Background="#D9534F"
                    Foreground="White"
                    FontWeight="Bold"
                    Visibility="{Binding IsGuest,
                        Converter={
                            StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>