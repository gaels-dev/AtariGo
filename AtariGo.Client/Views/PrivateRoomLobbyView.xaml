<UserControl x:Class="AtariGo.Client.Views.PrivateRoomLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             xmlns:views="clr-namespace:AtariGo.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5" FontSize="14" Foreground="#2C2A29">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="RoomActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C2A29"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EAEAEA"/>
                    <Setter Property="Foreground" Value="#2C2A29"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoomLeaveButtonStyle" TargetType="Button"
               BasedOn="{StaticResource RoomActionButtonStyle}">
            <Setter Property="Background" Value="#D9534F"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,24" VerticalContentAlignment="Center">
            <Border MaxWidth="520"
                    Padding="24"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock FontWeight="Bold"
                        Text="{x:Static properties:Resources.PrivateRoom_Lbl_Title}"
                        FontSize="26"
                        FontFamily="Georgia"
                        Foreground="#2C2A29"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Margin="0,0,0,20"/>

                    <TextBlock FontWeight="Bold"
                        Text="{x:Static properties:Resources.PrivateRoom_Lbl_InvitationCode}"
                        HorizontalAlignment="Center"/>

                    <TextBlock FontWeight="Bold" Text="{Binding RoomCode}"
                               FontSize="30"
                               FontFamily="Consolas"
                               Foreground="#4A90E2"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="Bold"
                                Text="{x:Static properties:Resources.PrivateRoom_Lbl_YouHost}"
                                FontSize="16"
                                TextWrapping="Wrap" TextAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsHost,
                                    Converter={
                                        StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock FontWeight="Bold"
                                Text="{Binding OpponentName}"
                                FontSize="16"
                                TextWrapping="Wrap" TextAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsGuest,
                                    Converter={
                                        StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                        <TextBlock FontWeight="Bold" Grid.Column="1"
                                   Text="VS"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="Bold"
                                Text="{Binding OpponentName}"
                                FontSize="16"
                                TextWrapping="Wrap" TextAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsHost,
                                    Converter={
                                        StaticResource BooleanToVisibilityConverter}}"/>

                            <TextBlock FontWeight="Bold"
                                Text="{x:Static properties:Resources.PrivateRoom_Lbl_YouGuest}"
                                FontSize="16"
                                TextWrapping="Wrap" TextAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsGuest,
                                    Converter={
                                        StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FDFBF7"
                            CornerRadius="8"
                            BorderBrush="#2C2A29"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                Text="{x:Static properties:Resources.PrivateRoom_Lbl_ActiveRules}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,5"/>

                            <StackPanel Visibility="{Binding IsHost,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding CaptureGoalLabel}" Margin="0,4,0,6"/>
                                <ComboBox ItemsSource="{Binding CaptureGoals}"
                                          SelectedItem="{Binding SelectedCaptureGoal, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEditConfiguration}" Height="38"
                                          Background="#FDFBF7" BorderBrush="#2C2A29"
                                          BorderThickness="1.5" FontSize="14"
                                          FontWeight="SemiBold" Padding="8"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Visibility="{Binding IsGuest,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding TargetCaptures}" FontWeight="Bold"/>
                                <TextBlock Margin="5,0,0,0"
                                    Text="{x:Static properties:Resources.PrivateRoom_Lbl_Captures}"/>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="1" Text="{Binding TurnTimeLabel}"
                                           Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding TurnTimeSeconds}"
                                           FontWeight="Bold" Margin="10,5,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding IsHost,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource RoomActionButtonStyle}"
                                Content="{Binding RoomInvitations.Title}"
                                Command="{Binding RoomInvitations.OpenCommand}"
                                IsEnabled="{Binding RoomInvitations.CanOpen}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D9534F"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Style="{StaticResource RoomActionButtonStyle}"
                        Content="{Binding StartGameLabel}"
                        Command="{Binding StartGameCommand}"
                        Margin="0,0,0,10"
                        IsEnabled="{Binding CanStartGame}"
                        Visibility="{Binding IsHost,
                            Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource RoomLeaveButtonStyle}"
                        Content="{x:Static properties:Resources.PrivateRoom_Btn_Disband}"
                        Command="{Binding LeaveRoomCommand}"
                        IsEnabled="{Binding CanLeaveRoom}"
                        Visibility="{Binding IsHost,
                            Converter={
                                StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Style="{StaticResource RoomLeaveButtonStyle}"
                        Content="{x:Static properties:Resources.PrivateRoom_Btn_Leave}"
                        Command="{Binding LeaveRoomCommand}"
                        IsEnabled="{Binding CanLeaveRoom}"
                        Visibility="{Binding IsGuest,
                            Converter={
                                StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Grid Grid.RowSpan="2" DataContext="{Binding RoomInvitations}"
              Background="#99000000" Panel.ZIndex="80"
              Visibility="{Binding IsOpen, FallbackValue=Collapsed,
                Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer Padding="20,24" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center">
                <Border MaxWidth="520" Padding="24" Background="White" CornerRadius="8"
                        BorderBrush="#2C2A29" BorderThickness="1.5"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <views:RoomInvitationsView/>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>