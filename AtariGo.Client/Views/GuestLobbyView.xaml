<UserControl x:Class="AtariGo.Client.Views.GuestLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="#E5D8C5">
        <StackPanel Width="275"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="{Binding TitleText}"
                       FontFamily="Georgia"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#2C2A29"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding PlayMultiplayerLabel}"
                    Command="{Binding PlayMultiplayerCommand}"
                    Height="58"
                    Margin="0,0,0,12"
                    Background="#4A90E2"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding OptionsLabel}"
                    Command="{Binding OptionsCommand}"
                    Height="48"
                    Margin="0,0,0,28"
                    Background="#EAEAEA"
                    Foreground="#2C2A29"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
            <Button Style="{StaticResource RoundedButtonStyle}"
                    Content="{Binding SignOutLabel}"
                    Command="{Binding SignOutCommand}"
                    Height="52"
                    Background="#D9534F"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderBrush="#B52B27"
                    BorderThickness="1.5"/>
        </StackPanel>
    </Grid>
</UserControl>
