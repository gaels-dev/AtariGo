<UserControl x:Class="AtariGo.Client.Views.GuestLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d">
    <Grid Background="#F7F7F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C2A29" Padding="25,15">
            <Grid>
                <TextBlock Text="ATARI GO"
                           FontSize="20"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White">
                    <Run Text="{x:Static properties:Resources.RegisterPlayerLobby_Lbl_Welcome}"/>
                    <Run Text="{Binding PlayerName, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#E5D8C5"
                Padding="45"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
            <Grid Width="700" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="10,0,35,0">
                    <Grid Width="150" Height="150" HorizontalAlignment="Center">
                        <Ellipse Fill="#F7F7F7"
                                 Stroke="#2C2A29"
                                 StrokeThickness="2"/>
                        <Ellipse Width="66"
                                 Height="66"
                                 Fill="White"
                                 Stroke="#2C2A29"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="22" Y="14"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="66"
                                 Height="66"
                                 Fill="#2C2A29"
                                 Stroke="#2C2A29"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-22" Y="-14"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding PlayerName}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#2C2A29"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,18,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F7F7F7"
                        BorderBrush="#C4B59D"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="32">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}"
                                   FontFamily="Georgia"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#2C2A29"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,25"/>
                        <Button Style="{StaticResource RoundedButtonStyle}"
                                Content="{Binding PlayMultiplayerLabel}"
                                Command="{Binding PlayMultiplayerCommand}"
                                Height="58"
                                Margin="0,0,0,12"
                                Background="#4A90E2"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                BorderBrush="#2C2A29"
                                BorderThickness="1.5"/>
                        <Button Style="{StaticResource RoundedButtonStyle}"
                                Content="{Binding OptionsLabel}"
                                Command="{Binding OptionsCommand}"
                                Height="48"
                                Margin="0,0,0,24"
                                Background="#EAEAEA"
                                Foreground="#2C2A29"
                                FontSize="15"
                                FontWeight="Bold"
                                BorderBrush="#2C2A29"
                                BorderThickness="1.5"/>
                        <Button Style="{StaticResource RoundedButtonStyle}"
                                Content="{Binding SignOutLabel}"
                                Command="{Binding SignOutCommand}"
                                Height="52"
                                Background="#D9534F"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                BorderBrush="#B52B27"
                                BorderThickness="1.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
