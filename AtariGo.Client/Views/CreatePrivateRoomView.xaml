<UserControl x:Class="AtariGo.Client.Views.CreatePrivateRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5" FontSize="14" Foreground="#2C2A29">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Center">
            <Border MaxWidth="440"
                    Padding="24"
                    Background="White"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock
                        Text="{x:Static properties:Resources.CreatePrivateRoom_Lbl_Title}"
                        FontSize="26"
                        FontWeight="Bold"
                        FontFamily="Georgia"
                        Foreground="#2C2A29"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Margin="0,0,0,20"/>

                    <TextBlock
                        Text="{x:Static properties:Resources.CreatePrivateRoom_Lbl_CaptureGoal}"
                        FontWeight="Bold"
                        FontSize="14"
                        Foreground="#2C2A29"
                        Margin="0,0,0,8"/>

                    <ComboBox ItemsSource="{Binding CaptureGoals}"
                              SelectedItem="{Binding SelectedCaptureGoal}"
                              Height="38"
                              FontSize="14" FontWeight="SemiBold"
                              Background="#FDFBF7" BorderBrush="#2C2A29"
                              BorderThickness="1.5" VerticalContentAlignment="Center"
                              Padding="8"
                              Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D9534F"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="{x:Static properties:Resources.CreatePrivateRoom_Btn_Cancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource RoundedButtonStyle}"
                            Height="42" FontSize="14" Padding="12,8"
                            Background="#D9534F"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderBrush="#B52B27"/>

                        <Button
                            Grid.Column="2"
                            Content="{x:Static properties:Resources.CreatePrivateRoom_Btn_Create}"
                            Command="{Binding CreateRoomCommand}"
                            Style="{StaticResource RoundedButtonStyle}"
                            Height="42" FontSize="14" Padding="12,8"
                            Background="#4A90E2"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderBrush="#2C2A29"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
