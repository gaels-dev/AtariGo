<UserControl x:Class="AtariGo.Client.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="#E5D8C5">
        <Border Background="White"
                BorderBrush="#2C2A29"
                BorderThickness="1.5"
                CornerRadius="8"
                Width="480"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Game Lobby"
                           FontSize="26"
                           FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#2C2A29"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <Border Background="#F7F5F0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Room Code"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#777777"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RoomCode}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#4A90E2"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Winning Condition (Captures Target)"
                           FontWeight="SemiBold"
                           Foreground="#2C2A29"
                           Margin="0,0,0,8"/>

                <ComboBox ItemsSource="{Binding CaptureTargetOptions}"
                          SelectedItem="{Binding SelectedCaptureTarget}"
                          Height="38"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,20"/>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Button Style="{StaticResource RoundedButtonStyle}"
                        Content="Start Game"
                        Command="{Binding StartGameCommand}"
                        Height="42"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="15"
                        BorderBrush="#2C2A29"
                        BorderThickness="1"
                        Margin="0,0,0,12"/>

                <Button Style="{StaticResource RoundedButtonStyle}"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Height="38"
                        Background="#DCDCDC"
                        Foreground="#2C2A29"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderBrush="#2C2A29"
                        BorderThickness="1"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
