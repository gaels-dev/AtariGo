<UserControl x:Class="AtariGo.Client.Views.FriendSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                    Command="{Binding SearchCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Border Grid.Row="1"
                Width="520"
                Padding="30"
                Background="White"
                BorderBrush="#2C2A29"
                BorderThickness="1.5"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock
                    Text="{x:Static properties:Resources.FriendSearch_Lbl_Title}"
                    FontSize="28"
                    FontWeight="Bold"
                    FontFamily="Georgia"
                    Foreground="#2C2A29"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

                <TextBlock
                    Text="{x:Static properties:Resources.FriendSearch_Lbl_Search}"
                    FontWeight="Bold"
                    Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#2C2A29"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="8,2">
                        <TextBox Text="{Binding SearchText,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="15"
                                 Height="36"
                                 Padding="2,6"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="{x:Static properties:Resources.FriendSearch_Btn_Search}"
                        Command="{Binding SearchCommand}"
                        Height="40"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#2C2A29"
                        BorderThickness="1.5"/>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#D9534F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,10"/>

                <Border Height="230"
                        Margin="0,0,0,15"
                        Padding="5"
                        BorderBrush="#2C2A29"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7F7F7">
                    <ListBox ItemsSource="{Binding SearchResults}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D0C8BC"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Background="White"
                                        Padding="9,7"
                                        Margin="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Username}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Username}"
                                                   Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding DataContext.AddFriendCommand,
                                                    RelativeSource={
                                                        RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanSendRequest}"
                                                Height="32"
                                                Padding="6,0"
                                                Background="#4A90E2"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderBrush="#2C2A29"
                                                BorderThickness="1"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Button
                    Style="{StaticResource RoundedButtonStyle}"
                    Content="{x:Static properties:Resources.FriendSearch_Btn_Back}"
                    Command="{Binding BackCommand}"
                    Height="42"
                    Background="#D9534F"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="#2C2A29"
                    BorderThickness="1.5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
