<UserControl x:Class="AtariGo.Client.Views.FriendSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Border Grid.Row="1"
                Width="520"
                Padding="30"
                Background="White"
                BorderBrush="#2C2A29"
                BorderThickness="1.5"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock
                    Text="{x:Static properties:Resources.FriendSearch_Lbl_Title}"
                    FontSize="28"
                    FontWeight="Bold"
                    FontFamily="Georgia"
                    Foreground="#2C2A29"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

                <TextBlock
                    Text="{x:Static properties:Resources.FriendSearch_Lbl_Search}"
                    FontWeight="Bold"
                    Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText,
                                 UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Padding="8"/>

                    <Button
                        Grid.Column="2"
                        Content="{x:Static properties:Resources.FriendSearch_Btn_Search}"
                        Command="{Binding SearchCommand}"
                        Height="40"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"/>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#D9534F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,10"/>

                <ListBox ItemsSource="{Binding SearchResults}"
                         Height="230"
                         Margin="0,0,0,15">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="{Binding Username}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"/>

                                <Button
                                    Grid.Column="1"
                                    Content="{x:Static properties:Resources.FriendSearch_Btn_Add}"
                                    Command="{Binding DataContext.AddFriendCommand,
                                        RelativeSource={
                                            RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Height="32"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button
                    Content="{x:Static properties:Resources.FriendSearch_Btn_Back}"
                    Command="{Binding BackCommand}"
                    Height="42"
                    Background="#D9534F"
                    Foreground="White"
                    FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>