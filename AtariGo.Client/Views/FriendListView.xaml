<UserControl x:Class="AtariGo.Client.Views.FriendListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:AtariGo.Client.Properties"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#E5D8C5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C2A29"
                Padding="25,15">
            <TextBlock Text="ATARI GO"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="White"/>
        </Border>

        <Border Grid.Row="1"
                Width="580"
                Padding="30"
                Background="White"
                BorderBrush="#2C2A29"
                BorderThickness="1.5"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock
                    Text="{x:Static properties:Resources.FriendList_Lbl_Title}"
                    FontSize="28"
                    FontWeight="Bold"
                    FontFamily="Georgia"
                    Foreground="#2C2A29"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

                <TextBlock Text="{Binding FriendRemoval.StatusMessage}"
                           Foreground="#4A90E2"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding EmptyLabel}" Foreground="#666666"
                           TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding Friends}"
                         Height="300"
                         Margin="0,0,0,15">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}"
                                               FontWeight="Bold" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Username}"/>

                                    <TextBlock
                                        Text="{x:Static properties:Resources.FriendList_Lbl_Friend}"
                                        FontSize="11"
                                        Foreground="Gray"/>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Content="{x:Static properties:Resources.FriendList_Btn_Invite}"
                                    IsEnabled="False"
                                    Height="32"/>

                                <Button
                                    Grid.Column="3"
                                    Content="{x:Static properties:Resources.FriendList_Btn_Remove}"
                                    Command="{Binding DataContext.FriendRemoval.RemoveCommand,
                                        RelativeSource={
                                            RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Height="32"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button
                    Content="{x:Static properties:Resources.FriendList_Btn_Back}"
                    Command="{Binding BackCommand}"
                    Height="42"
                    Background="#D9534F"
                    Foreground="White"
                    FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>