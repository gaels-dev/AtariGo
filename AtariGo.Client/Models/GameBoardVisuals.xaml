<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Geometry x:Key="PixelStoneOutline">
        M12,2 H20 V4 H24 V6 H28 V10 H30 V22 H28 V26 H24 V28 H20 V30
        H12 V28 H8 V26 H4 V22 H2 V10 H4 V6 H8 V4 H12 Z
