    <DrawingImage x:Key="BlackPixelStone">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H34 V36 H0 Z"/>
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <TranslateTransform X="2" Y="3"/>
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#553B2917"
                                     Geometry="{StaticResource PixelStoneOutline}"/>
                </DrawingGroup>
                <GeometryDrawing Brush="#151C25" Geometry="{StaticResource PixelStoneOutline}"/>
                <GeometryDrawing Brush="#2C3745" Geometry="{StaticResource PixelStoneFace}"/>
                <GeometryDrawing Brush="#0B111A" Geometry="{StaticResource PixelStoneLowerEdge}"/>
                <GeometryDrawing Brush="#526172" Geometry="{StaticResource PixelStoneHighlight}"/>
                <GeometryDrawing Brush="#6C7986" Geometry="M10,6 H14 V8 H10 Z"/>
                <GeometryDrawing Brush="#394655" Geometry="M6,14 H8 V20 H6 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="WhitePixelStone">
        <DrawingImage.Drawing>
            <DrawingGroup>
