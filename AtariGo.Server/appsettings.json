{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Diagnostics": {
    "MaximumFileBytes": 5242880,
    "MaximumTotalBytes": 52428800,
    "QueueCapacity": 1000,
    "Retention": "7.00:00:00",
    "RetryDelay": "00:00:01",
    "ShutdownTimeout": "00:00:05"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "https://localhost:7061"
      }
    }
  },
  "AtariGo": {
    "Lan": {
      "Port": 7062
    }
  },
  "ConnectionStrings": {
    "AtariGoConnection": ""
  }
}
